{
    // Tulip HTTP GET benchmark profile
    // Target URL, rate, duration, and warmup are overridden at runtime.
    // See catalog.yaml for override path mappings.
    "actions": {
        "output_filename": "",
        "report_filename": "",
        "user_class": "org.example.user.TestHttpUser",
        "user_params": {
            "url": ""
        },
        "user_actions": {
            "0": "onStart",
            "3": "GET",
            "100": "onStop"
        }
