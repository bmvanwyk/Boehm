    "contexts": {
        "default": {
            "enabled": true,
            "num_users": 5,
            "num_threads": 1
        }
    },
    "benchmarks": {
        "boehm-benchmark": {
            "enabled": true,
            "aps_rate": 0.0,
            "warmup_duration1": 0,
            "warmup_duration2": 0,
            "benchmark_duration": 0,
            "benchmark_iterations": 1,
            "scenario_actions": [
                { "id": 3, "weight": 0 }
            ]
        }
    }
}
